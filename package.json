{
  "name": "gh-pr-tree-render",
  "private": true,
  "engines": { "node": ">=26.0.0 <27" },
  "version": "1.0.0",
  "description": "a Sails application",
  "keywords": [],
  "dependencies": {
    "@dagrejs/dagre": "^3.1.4",
    "@octokit/core": "^7.0.8",
    "@sailshq/connect-redis": "^6.1.3",
    "@sailshq/lodash": "^3.10.7",
    "@sailshq/socket.io-redis": "^6.1.2",
    "@xyflow/react": "^13.0.3",
    "axios": "^1.21.1",
    "bootstrap": "^5.3.9",
    "express-static-gzip": "^3.0.2",
    "grunt": "^1.6.3",
    "react": "^19.3.1",
    "react-bootstrap": "^2.10.10",
    "react-bootstrap-icons": "^1.11.6",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7",
    "sails": "^1.5.18",
    "sails-hook-grunt": "^5.0.2",
    "sails-hook-orm": "^4.0.3",
    "sails-hook-sockets": "^3.0.2",
    "sails-sqlite": "^0.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.4",
    "sass": "^1.108.2",
    "vite": "^8.4.0",
    "vite-plugin-compression2": "^2.5.4"
  },
  "scripts": {
    "start:dev": "npm-run-all --parallel open:client lift",
    "start": "npm-run-all build start-app",
    "start:debug": "npm-run-all --parallel open:client debug",
    "open:client": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:prod": "vite build",
    "clean": "rimraf .tmp/public",
    "lift": "sails lift",
    "debug": "node --inspect app.js",
    "start-dev": "NODE_ENV=development node app.js",
    "start-app": "NODE_ENV=production node app.js",
    "test": "npm run lint && npm run custom-tests",
    "lint": "./node_modules/eslint/bin/eslint.js . --max-warnings=0 --report-unused-disable-directives && echo '✔  Your .js files look good.'",
    "custom-tests": "node --test test/*.test.mjs"
  },
  "main": "app.js",
  "repository": {
    "type": "git",
    "url": "git://github.com/sposmen/gh-pr-tree-render.git"
  },
  "author": "sposmen",
  "license": ""
}
